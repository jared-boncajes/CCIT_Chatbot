# Copy this file to .env beside app.py, then enter your own key in .env only.
CHAT_MODE=ai
CCIT_AI_PROVIDER=gemini
GEMINI_API_KEY=
CCIT_MODEL=gemini-3.8-flash

# For OpenAI, change the provider and model above and add CCIT_API_KEY:
# CCIT_AI_PROVIDER=openai
# CCIT_MODEL=gpt-4.1-mini
# CCIT_API_KEY=

# For retrieval-only demonstrations without any API key: CHAT_MODE=faq
